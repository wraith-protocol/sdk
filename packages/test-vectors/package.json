{
  "name": "@wraith-protocol/test-vectors",
  "version": "1.0.0",
  "description": "Deterministic test vectors for cross-language verification of Wraith stealth address cryptography",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vectors/*": "./vectors/*.json",
    "./checksum.json": "./checksum.json"
  },
  "files": [
    "dist",
    "vectors",
    "checksum.json",
    "README.md"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "verify": "tsx scripts/verify.ts",
    "build": "tsup",
    "clean": "rm -rf dist vectors checksum.json"
  },
  "keywords": [
    "wraith",
    "stealth-addresses",
    "test-vectors",
    "cryptography",
    "cross-language",
    "evm",
    "stellar",
    "solana",
    "ckb",
    "nervos"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wraith-protocol/sdk",
    "directory": "packages/test-vectors"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@wraith-protocol/sdk": "workspace:*",
    "tsup": "^8.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "viem": "^2.23.0"
  }
}

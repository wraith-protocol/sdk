{
  "schemaVersion": "1.0.0",
  "seed": "0x57524149",
  "timestampPolicy": "Volatile wall-clock timestamps are excluded (`timeoutSeconds: 0` -> `timeBounds: null` on Stellar; no blockhash/timestamp in EVM calldata, Solana instructions, or CKB cell skeletons) or normalized explicitly (`timeBounds: { minTime: 0, maxTime: 1700000180 }`).",
  "chainDifferences": {
    "evm": {
      "envelopeModel": "ABI-encoded contract calldata (`{ to, data, value }`) without nonce, gasPrice, or block timestamp; wallets populate EIP-1559 envelope fields at signing time.",
      "schemeId": "1 (ERC-5564 secp256k1 with 1-byte keccak256 viewTag)",
      "sendVsAnnounce": "`buildSendStealth` and `buildSendERC20` atomically transfer assets and emit the ERC-5564 Announcement via `WraithSender`; `buildAnnounce` targets `ERC5564Announcer.announce` directly (`value: 0`)."
    },
    "stellar": {
      "envelopeModel": "Full unsigned Stellar Transaction V1 XDR envelope (`TransactionEnvelope` base64 + network-domain SHA-256 `txHash`). Increments `source.sequence` by +1. Default runtime timeout (`180s`) reads `Date.now()`; vectors normalize this via `timeoutSeconds: 0` (`timeBounds: null`) or explicit `timeBounds`.",
      "schemeId": "2 (Soroban v2 announcer with public view-tag derivation `wraith:stellar:view-tag:v2:`)",
      "sendVsAnnounce": "Classic value transfer (`CreateAccount` for unfunded native XLM, `Payment` for funded native XLM, `CreateClaimableBalance` for issued tokens without requiring a recipient trustline) is separate from the Soroban `announce` host-function invocation (`buildStealthAnnouncement`)."
    },
    "solana": {
      "envelopeModel": "Unsigned Solana instruction (`{ programId, keys, data }`) with Borsh-encoded little-endian payload and 8-byte Anchor discriminator. `recentBlockhash` and fee-payer message headers are intentionally excluded until submission.",
      "schemeId": "1 (ed25519 + X25519 ECDH with 1-byte SHA-256 viewTag)",
      "sendVsAnnounce": "`buildSendSol` atomically transfers lamports via CPI to `SystemProgram` and logs `AnnouncementEvent` (89-byte data); `buildAnnounce` invokes `wraith-announcer` standalone (81-byte data)."
    },
    "ckb": {
      "envelopeModel": "Unsigned CKB Cell/UTXO transaction skeleton (`{ version, cellDeps, headerDeps, outputs, outputsData }`) with `0x`-prefixed quantity hex capacity and `data2` lock script.",
      "schemeId": "1 (secp256k1 ECDH + SHA-256 scalar + blake160 pubkey hash; no 1-byte viewTag)",
      "sendVsAnnounce": "Single combined `send_and_announce` operation (`buildSendCkb`): in CKB’s Cell model the live output cell’s 53-byte `lock.args` (`ephemeral_pub (33B) || blake160(stealth_pub) (20B)`) IS the on-chain announcement, so no separate announcer contract exists."
    }
  },

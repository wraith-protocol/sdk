{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@wraith-protocol/sdk": ["../../src/index.ts"],
      "@wraith-protocol/sdk/chains/*": ["../../src/chains/*/index.ts"]
    }
  },
  "include": ["index.ts", "wallet-registry.ts"]
}

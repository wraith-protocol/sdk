# Your Wraith API key (wraith_live_... or wraith_test_...)
# Sign up at https://wraith.dev to get one.
AGENT_API_KEY="wraith_live_..."

# Agent name to create or look up (e.g. "alice")
AGENT_NAME="alice"

# Your wallet address on Stellar (G...)
STELLAR_WALLET="G..."

# A signature proving wallet ownership (from wallet.sign(message))
STELLAR_SIGNATURE="..."

# Optional: custom API base URL (omit for default https://api.wraith.dev)
# AGENT_BASE_URL="https://api.wraith.dev"

# Your Stellar wallet secret key (base64-encoded ed25519 seed, or the raw 64-byte hex)
# Used to derive stealth keys for receiving. For a real wallet, use wallet.sign(STEALTH_SIGNING_MESSAGE).
STELLAR_SECRET_KEY="your-64-byte-hex-secret-key-here"

# The recipient's stealth meta-address (st:xlm:... format)
# This is the address you want to send funds to privately.
RECIPIENT_META_ADDRESS="st:xlm:..."
